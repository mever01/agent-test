# =============================================================================
# PostgreSQL + pgvector
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=email_agent_db
DB_POOL_SIZE=10

# =============================================================================
# RabbitMQ
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_THREADS_QUEUE=rag.threads.queue
RABBITMQ_DOCUMENTS_QUEUE=rag.documents.queue
RABBITMQ_EXCHANGE=rag.events

# =============================================================================
# Эмбеддер (Qwen3-Embedding-0.6B)
# =============================================================================
# Для локального контейнера (docker-compose.embedder.yml):
EMBEDDING_URL=http://localhost:11434/api/embeddings
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=

# =============================================================================
# Основная LLM (Qwen2.5 / OpenAI / OpenRouter)
# =============================================================================
# Для локального контейнера (docker-compose.llm.yml):
LLM_URL=http://localhost:11435/v1/chat/completions
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TEMPERATURE=0.1

# =============================================================================
# Безопасность и Guardrails
# =============================================================================
SECURITY_EVENTS_PATH=security_events.jsonl
CANARY_PREFIX=CANARY_SEC_
MAX_USER_MESSAGE_LENGTH=4000

